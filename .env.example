# Copy to `.env` in this directory. Do not commit `.env`.
#
# Docker Compose loads this file via `env_file` for `db` and `backend`.
# Use hostname `db` in DATABASE_URL so the backend container reaches Postgres on the Compose network.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

POSTGRES_HOST_PORT=5432

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://user:password@db:5432/dbname

# Required for `POST /auth/login` (JWT signing). Use a long random string in real deployments.
JWT_SECRET=change-me-in-production
# Optional. Access token lifetime in seconds (default 86400 = 24h).
# JWT_EXPIRES_IN=86400

# SPA origin for CORS + credentialed cookie requests (Vite default).
CORS_ORIGIN=http://localhost:5173
